<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
  </appSettings>
  <connectionStrings>
    <add name="BookswapConnectionString1" connectionString="Data Source=MRDHRUV\SQLEXPRESS01;Initial Catalog=BookSwapDB;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime maxRequestLength="51200" executionTimeout="360" targetFramework="4.8"/>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Client/Error.aspx">
      <error statusCode="404" redirect="~/Client/404.aspx"/>
    </customErrors>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Client/Home.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>